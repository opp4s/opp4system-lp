---
---

<section id="contato" class="py-24 relative">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-accent/10 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <span class="text-brand-accent font-semibold text-sm tracking-wider uppercase mb-4 block">
          Contato
        </span>
        <h2 class="section-title mb-6">
          Vamos conversar sobre o{' '}
          <span class="gradient-text">seu projeto</span>?
        </h2>
        <p class="text-brand-muted text-lg leading-relaxed mb-8">
          Preencha o formulário ao lado e nossa equipe entrará em contato 
          para entender suas necessidades e apresentar a melhor solução 
          para o seu negócio.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-accent/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-heading font-semibold text-brand-foreground mb-1">Diagnóstico Gratuito</h4>
              <p class="text-sm text-brand-muted">Analisamos seus processos sem nenhum custo.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-accent/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-heading font-semibold text-brand-foreground mb-1">Proposta Personalizada</h4>
              <p class="text-sm text-brand-muted">Solução sob medida para suas necessidades.</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-accent/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-heading font-semibold text-brand-foreground mb-1">Suporte Dedicado</h4>
              <p class="text-sm text-brand-muted">Acompanhamento em todas as etapas do projeto.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div>
        <div class="glass-card-strong p-8 rounded-3xl">
          <form id="contact-form" class="space-y-5">
            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <input
                type="text"
                name="name"
                placeholder="Seu nome"
                required
                class="w-full pl-12 pr-4 py-4 bg-glass-light border border-brand-border rounded-xl 
                       text-brand-foreground placeholder:text-brand-muted/50 focus:outline-none 
                       focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-all duration-200"
              />
            </div>

            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <input
                type="text"
                name="company"
                placeholder="Sua empresa"
                required
                class="w-full pl-12 pr-4 py-4 bg-glass-light border border-brand-border rounded-xl 
                       text-brand-foreground placeholder:text-brand-muted/50 focus:outline-none 
                       focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-all duration-200"
              />
            </div>

            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <input
                type="email"
                name="email"
                placeholder="E-mail"
                required
                class="w-full pl-12 pr-4 py-4 bg-glass-light border border-brand-border rounded-xl 
                       text-brand-foreground placeholder:text-brand-muted/50 focus:outline-none 
                       focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-all duration-200"
              />
            </div>

            <div class="relative">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <input
                type="tel"
                name="whatsapp"
                placeholder="WhatsApp"
                class="w-full pl-12 pr-4 py-4 bg-glass-light border border-brand-border rounded-xl 
                       text-brand-foreground placeholder:text-brand-muted/50 focus:outline-none 
                       focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-all duration-200"
              />
            </div>

            <div class="relative">
              <svg class="absolute left-4 top-4 w-5 h-5 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <textarea
                name="message"
                placeholder="Descreva seu desafio"
                rows={4}
                class="w-full pl-12 pr-4 py-4 bg-glass-light border border-brand-border rounded-xl 
                       text-brand-foreground placeholder:text-brand-muted/50 focus:outline-none 
                       focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-all duration-200 
                       resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full btn-primary flex items-center justify-center gap-2 py-4"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
              Enviar Mensagem
            </button>

            <p class="text-xs text-brand-muted text-center">
              Respondemos em até 24 horas úteis.
            </p>
          </form>

          <!-- Success message (hidden by default) -->
          <div id="success-message" class="hidden text-center py-12">
            <div class="w-16 h-16 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-brand-foreground text-xl mb-2">
              Mensagem Enviada!
            </h3>
            <p class="text-brand-muted">
              Nossa equipe entrará em contato em breve.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Hide form, show success
    form.style.display = 'none';
    successMessage?.classList.remove('hidden');
    
    // Reset after 5 seconds
    setTimeout(() => {
      form.style.display = 'block';
      successMessage?.classList.add('hidden');
      form.reset();
    }, 5000);
  });
</script>
