---
const steps = [
  {
    number: '01',
    title: 'Diagnóstico',
    description: 'Analisamos seus processos, sistemas e desafios para entender exatamente o que sua empresa precisa.',
    icon: 'search',
  },
  {
    number: '02',
    title: 'Planejamento',
    description: 'Desenhamos a solução ideal com escopo claro, cronograma definido e expectativas alinhadas.',
    icon: 'clipboard',
  },
  {
    number: '03',
    title: 'Desenvolvimento',
    description: 'Construímos sua solução com as melhores tecnologias, entregas incrementais e total transparência.',
    icon: 'code',
  },
  {
    number: '04',
    title: 'Implantação',
    description: 'Implementamos a solução com testes rigorosos, treinamento da equipe e suporte dedicado.',
    icon: 'rocket',
  },
  {
    number: '05',
    title: 'Suporte e Evolução',
    description: 'Acompanhamos os resultados, realizamos ajustes e evoluímos a solução continuamente.',
    icon: 'headphones',
  },
];

const icons: Record<string, string> = {
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  clipboard: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  rocket: 'M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z',
  headphones: 'M3 18v-6a9 9 0 0118 0v6',
};
---

<section id="como-funciona" class="py-24 relative">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-purple-500/5 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-brand-accent font-semibold text-sm tracking-wider uppercase mb-4 block">
        Como Funciona
      </span>
      <h2 class="section-title mb-6">
        Uma jornada simples para{' '}
        <span class="gradient-text">transformar sua operação</span>
      </h2>
      <p class="section-subtitle">
        Nosso processo é transparente, colaborativo e focado em entregar 
        resultados reais em cada etapa.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Connection line (desktop) -->
      <div class="hidden lg:block absolute top-24 left-[10%] right-[10%] h-px bg-gradient-to-r from-transparent via-brand-accent/30 to-transparent"></div>

      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6">
        {steps.map((step, index) => (
          <div class="relative">
            <div class="glass-card p-6 rounded-2xl text-center hover:bg-glass-medium transition-all duration-300 group h-full">
              <!-- Number -->
              <div class="text-4xl font-heading font-bold text-brand-accent/20 mb-4 group-hover:text-brand-accent/40 transition-colors">
                {step.number}
              </div>
              
              <!-- Icon -->
              <div class="w-16 h-16 rounded-2xl bg-brand-accent/20 flex items-center justify-center mx-auto mb-4 
                          group-hover:bg-brand-accent/30 transition-colors duration-300">
                <svg class="w-8 h-8 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[step.icon]} />
                </svg>
              </div>
              
              <h3 class="font-heading font-semibold text-brand-foreground mb-3 text-lg">
                {step.title}
              </h3>
              
              <p class="text-sm text-brand-muted leading-relaxed">
                {step.description}
              </p>
            </div>

            {/* Mobile arrow */}
            {index < steps.length - 1 && (
              <div class="lg:hidden flex justify-center py-4">
                <div class="w-px h-8 bg-brand-accent/30"></div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
