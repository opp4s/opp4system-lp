---
---

<section id="inicio" class="relative min-h-screen flex items-center pt-24 pb-16 overflow-hidden">
  <!-- Background gradient orbs -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-accent/20 rounded-full filter blur-[120px] animate-float"></div>
  <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-purple-500/15 rounded-full filter blur-[100px] animate-float" style="animation-delay: 2s;"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="animate-fade-in-up">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card mb-6">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span class="text-sm text-brand-muted">Tecnologia que transforma resultados</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold leading-tight mb-6">
          Transforme sua empresa com{' '}
          <span class="gradient-text">Inteligência Artificial</span>{' '}
          e Automação
        </h1>

        <p class="text-lg md:text-xl text-brand-muted mb-8 leading-relaxed">
          Desenvolvemos soluções sob medida que integram sistemas, automatizam processos 
          e aplicam IA para gerar eficiência, reduzir custos e escalar seu negócio.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="#contato" class="btn-primary flex items-center justify-center gap-2">
            Solicitar Demonstração
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#solucoes" class="btn-secondary flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            Ver Soluções
          </a>
        </div>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <div class="text-xl font-heading font-bold text-brand-foreground">98%</div>
              <div class="text-xs text-brand-muted">Redução de processos manuais</div>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div>
              <div class="text-xl font-heading font-bold text-brand-foreground">3x</div>
              <div class="text-xs text-brand-muted">Aumento de produtividade</div>
            </div>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-accent/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <div class="text-xl font-heading font-bold text-brand-foreground">100%</div>
              <div class="text-xs text-brand-muted">Segurança da informação</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div class="relative hidden lg:block">
        <div class="relative w-full h-[500px]">
          <!-- Main glass card -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 glass-card-strong rounded-3xl rotate-6 animate-float">
            <div class="absolute inset-4 flex flex-col items-center justify-center">
              <div class="w-16 h-16 rounded-2xl bg-brand-accent/30 flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="text-2xl font-heading font-bold text-brand-foreground">Opp4System</div>
              <div class="text-sm text-brand-muted">Automação Inteligente</div>
            </div>
          </div>

          <!-- Floating card 1 -->
          <div class="absolute top-20 right-10 glass-card p-4 rounded-2xl animate-float" style="animation-delay: 1s;">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-green-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-foreground">+150%</div>
                <div class="text-xs text-brand-muted">Eficiência</div>
              </div>
            </div>
          </div>

          <!-- Floating card 2 -->
          <div class="absolute bottom-20 left-10 glass-card p-4 rounded-2xl animate-float" style="animation-delay: 3s;">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-purple-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-foreground">IA Avançada</div>
                <div class="text-xs text-brand-muted">Chatbots & Automations</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
    <div class="w-6 h-10 rounded-full border-2 border-brand-border flex justify-center pt-2">
      <div class="w-1 h-2 rounded-full bg-brand-accent animate-bounce"></div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>
