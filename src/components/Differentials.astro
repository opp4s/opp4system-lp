---

<section id="diferenciais" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-brand-accent font-semibold text-sm tracking-wider uppercase mb-4 block">
        Diferenciais
      </span>
      <h2 class="section-title mb-6">
        Por que escolher a{' '}
        <span class="gradient-text">Opp4System</span>?
      </h2>
      <p class="section-subtitle">
        Nosso compromisso vai além da entrega técnica. Somos parceiros 
        estratégicos no crescimento do seu negócio.
      </p>
    </div>

    <!-- Differentials Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {differentials.map((differential) => (
        <div class="glass-card p-6 rounded-2xl hover:bg-glass-medium transition-all duration-300 group text-center">
          <div class="w-14 h-14 rounded-2xl bg-brand-accent/20 flex items-center justify-center mx-auto mb-4 
                      group-hover:bg-brand-accent/30 group-hover:scale-110 transition-all duration-300">
            <svg class="w-7 h-7 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[differential.icon]} />
            </svg>
          </div>
          
          <h3 class="font-heading font-semibold text-brand-foreground mb-2">
            {differential.title}
          </h3>
          
          <p class="text-sm text-brand-muted leading-relaxed">
            {differential.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
