  {
    icon: 'users',
    title: 'CRM Inteligente',
    description: 'Gestão de relacionamento com IA que prevê necessidades dos clientes.',
  },
  {
    icon: 'database',
    title: 'Integração ERP',
    description: 'Sincronização completa entre sistemas de gestão e operações.',
