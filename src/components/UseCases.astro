---

<section id="casos-de-uso" class="py-24 relative">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-accent/5 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-brand-accent font-semibold text-sm tracking-wider uppercase mb-4 block">
        Casos de Uso
      </span>
      <h2 class="section-title mb-6">
        Aplicações reais que{' '}
        <span class="gradient-text">geram resultado</span>
      </h2>
      <p class="section-subtitle">
        Veja como nossas soluções são aplicadas em diferentes cenários 
        para resolver problemas reais de empresas.
      </p>
    </div>

    <!-- Use Cases Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-4">
      {useCases.map((useCase) => (
        <div class="glass-card p-5 rounded-2xl hover:bg-glass-medium transition-all duration-300 group">
          <div class="w-10 h-10 rounded-xl bg-brand-accent/20 flex items-center justify-center mb-3 
                      group-hover:bg-brand-accent/30 transition-colors duration-300">
            <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[useCase.icon]} />
            </svg>
          </div>
          
          <h3 class="font-heading font-semibold text-brand-foreground mb-2 text-sm">
            {useCase.title}
          </h3>
          
          <p class="text-xs text-brand-muted leading-relaxed">
            {useCase.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
