  {
    icon: 'brain',
    title: 'Inteligência Artificial',
    description: 'Implementação de IA para automatizar decisões, analisar dados e otimizar processos complexos.',
    features: ['Análise preditiva', 'Processamento de linguagem natural', 'Machine Learning'],
  },
  {
    icon: 'workflow',
    title: 'Automação de Processos',
    description: 'Eliminação de tarefas repetitivas e criação de fluxos inteligentes que economizam tempo e recursos.',
    features: ['RPA avançado', 'Workflows personalizados', 'Integrações automáticas'],
  },
  {
    icon: 'code',
    title: 'Desenvolvimento de Sistemas',
    description: 'Criação de sistemas sob medida que resolvem desafios específicos do seu negócio.',
    features: ['Sistemas web', 'Aplicativos mobile', 'APIs personalizadas'],
  },
  {
    icon: 'link',
    title: 'Integrações entre Plataformas',
    description: 'Conexão fluida entre seus sistemas existentes para unificar dados e processos.',
    features: ['APIs REST/GraphQL', 'Webhooks', 'Middlewares'],
  },
  {
    icon: 'message',
    title: 'Chatbots Inteligentes',
    description: 'Atendimento automatizado 24/7 que resolve problemas e qualifica leads automaticamente.',
    features: ['NLP avançado', 'Multi-canal', 'Aprendizado contínuo'],
  },
  {
    icon: 'dashboard',
    title: 'Dashboards Gerenciais',
    description: 'Visualizações de dados em tempo real para tomada de decisão assertiva.',
    features: ['Métricas em tempo real', 'Relatórios automáticos', 'KPIs personalizados'],
  },
  {
    icon: 'chart',
    title: 'CRM Inteligente',
    description: 'Gestão de relacionamento com IA que prevê necessidades e otimiza oportunidades.',
    features: ['Lead scoring', 'Pipeline inteligente', 'Automação comercial'],
  },
  {
    icon: 'database',
    title: 'Integração com ERPs',
    description: 'Conexão completa com seus sistemas de gestão para dados unificados e processos otimizados.',
    features: ['SAP, TOTVS, Bling', 'Sincronização real-time', 'Migração de dados'],
