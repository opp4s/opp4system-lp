---

<section id="solucoes" class="py-24 relative">
  <!-- Background accent -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-brand-accent/5 to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="text-brand-accent font-semibold text-sm tracking-wider uppercase mb-4 block">
        Nossas Soluções
      </span>
      <h2 class="section-title mb-6">
        Tecnologia completa para{' '}
        <span class="gradient-text">transformar seu negócio</span>
      </h2>
      <p class="section-subtitle">
        Oferecemos um ecossistema completo de soluções tecnológicas que se integram 
        para gerar eficiência e resultado em toda a sua operação.
      </p>
    </div>

    <!-- Solutions Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {solutions.map((solution) => (
        <div class="glass-card p-6 rounded-2xl hover:bg-glass-medium transition-all duration-300 cursor-pointer group">
          <div class="w-12 h-12 rounded-xl bg-brand-accent/20 flex items-center justify-center mb-4 
                      group-hover:bg-brand-accent/30 transition-colors duration-300">
            <svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[solution.icon]} />
            </svg>
          </div>
          
          <h3 class="font-heading font-semibold text-brand-foreground mb-2 text-lg">
            {solution.title}
          </h3>
          
          <p class="text-sm text-brand-muted mb-4 leading-relaxed">
            {solution.description}
          </p>

          <ul class="space-y-2">
            {solution.features.map((feature) => (
              <li class="flex items-center gap-2 text-xs text-brand-muted">
                <div class="w-1.5 h-1.5 rounded-full bg-brand-accent/50"></div>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="text-center mt-12">
      <a href="#contato" class="btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Discuta seu projeto conosco
      </a>
    </div>
  </div>
</section>
